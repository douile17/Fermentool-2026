# Rust
/target
**/*.rs.bk
# Cargo.lock IS committed — fermentool-core is an application, not a library.

# Tauri shell: build output and the daemon sidecar copied in at package time.
/src-tauri/target
/src-tauri/gen
/src-tauri/binaries/*.exe

# Node / web UI
node_modules/
# ui/dist/ IS committed — rust-embed bakes it into the daemon binary, so the
# crate must always build. Rebuild it with `npm run build` and commit alongside
# UI source changes.

# Local runtime data, logs, and machine-specific config
/data/
/.localrun/
/.localrun.log
*.sqlite
*.sqlite-wal
*.sqlite-shm
/config.toml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
