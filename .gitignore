# Rust
/target
**/*.rs.bk
# Cargo.lock IS committed — fermentool-core is an application, not a library.

# Node / web UI
node_modules/
ui/dist/

# UI build output embedded into the daemon binary (generated by `npm run build`)
/crates/fermentool-core/assets/*
!/crates/fermentool-core/assets/.gitkeep

# Local runtime data, logs, and machine-specific config
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
/config.toml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
